{
  "name": "blackout-app",
  "productName": "Blackout",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "app": "electron .",
    "build:voice": "swiftc -O native/SpeechHelper.swift -o build/speech-helper -framework Speech -framework AVFoundation -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker native/SpeechHelper-Info.plist",
    "dist": "npm run build:voice && electron-builder --mac"
  },
  "build": {
    "appId": "org.blackout.dashboard",
    "productName": "Blackout",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!test/**",
          "!tools/**",
          "!.env"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!.cache/**"
        ]
      },
      {
        "from": "build/speech-helper",
        "to": "speech-helper"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Blackout pairs with the recon rover over Bluetooth LE.",
        "NSMicrophoneUsageDescription": "Blackout uses the microphone for voice messages to Sage.",
        "NSSpeechRecognitionUsageDescription": "Blackout uses speech recognition to turn your voice into messages for Sage."
      }
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
