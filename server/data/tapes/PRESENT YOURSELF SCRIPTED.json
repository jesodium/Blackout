      "ms": 0,
      "cmd": "@say Hey! I'm Sage, the AI assistant riding on this rover. I keep the operator company, and I read the room around me."
    },
    {
      "ms": 0,
      "cmd": "@say.es ¡Hola! Soy Sage, la asistente de inteligencia artificial que viaja en este rover. Acompaño al operador y leo el entorno a mi alrededor."
    },
    {
      "ms": 6000,
      "cmd": "@say I watch the air, the temperature, how far the walls are and how much light there is, and I call out anything that looks wrong."
    },
    {
      "ms": 6000,
      "cmd": "@say.es Vigilo el aire, la temperatura, a qué distancia están las paredes y cuánta luz hay, y aviso de cualquier cosa que no vaya bien."
    },
    {
      "ms": 12500,
      "cmd": "@say And the best part — I have an arm!"
